# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Copy to .env and fill in. Every value can also come from the environment,
# which wins over this file. There is no interactive setup (NFR-11).
# Point NUNO_CONFIG at this file to load it outside compose.

# --- The admin surface -------------------------------------------------------

# Where the admin surface listens. Loopback by default: listening wider needs
# NUNO_ALLOW_PUBLIC_BIND, so it is never an accident (NFR-14).
NUNO_ADDR=127.0.0.1:8080
# NUNO_ALLOW_PUBLIC_BIND=false

# A human logging into the UI when no proxy provides auth. One of the three
# credential types, and not interchangeable with the others (ADR-0022).
# NUNO_ADMIN_PASSWORD=

# --- The usage API -----------------------------------------------------------

# The admin key: machine, read-only, for GET /api/v1/usage. This is what a
# Homepage customapi widget sends as a bearer token. Generate with
# `openssl rand -hex 32`. Without it the endpoint refuses every request
# (FR-46a).
# NUNO_ADMIN_KEY=

# Optional separate listener for the usage API, so exposing usage to a
# dashboard never means exposing the admin panel.
# NUNO_USAGE_ADDR=127.0.0.1:8081

# --- Storage and logging -----------------------------------------------------

# The SQLite file and its pre-migration backups live here. Put it on a
# snapshotted dataset: it is the only home for policy (ADR-0019).
NUNO_DATA_DIR=/data
# NUNO_LOG_LEVEL=info
# How often usage is refreshed without reconciling. Also what makes a reading
# "stale" in the API, at twice this value (ADR-0022).
# NUNO_REFRESH_INTERVAL=15m

# --- Providers ---------------------------------------------------------------
#
# One block per instance: NUNO_PROVIDER_<NAME>_*. The name is yours, and it is
# what the UI and the CLI call that instance. TYPE, URL, MATCH_KEY and TIMEOUT
# are settings; every other key under the prefix is treated as a credential and
# is redacted everywhere.

# Nextcloud. An app password cannot write a quota: it gets 403 "Password
# confirmation is required". Use a dedicated admin without 2FA, or whitelist
# Nuno's address in allowed_no_password_confirmation_ranges (ADR-0014).
# Before Nuno can manage the instance, move the default quota out of
# oidc_login_default_quota and into files/default_quota: the first is rewritten
# on every OIDC login. `nuno doctor --fix` emits the commands (ADR-0027).
NUNO_PROVIDER_CLOUD_TYPE=nextcloud
NUNO_PROVIDER_CLOUD_URL=https://cloud.example.org
NUNO_PROVIDER_CLOUD_MATCH_KEY=email
NUNO_PROVIDER_CLOUD_USERNAME=nuno-admin
NUNO_PROVIDER_CLOUD_PASSWORD=

# Immich. The API key needs adminUser.read and adminUser.update, never all.
NUNO_PROVIDER_PHOTOS_TYPE=immich
NUNO_PROVIDER_PHOTOS_URL=https://photos.example.org
NUNO_PROVIDER_PHOTOS_MATCH_KEY=email
NUNO_PROVIDER_PHOTOS_API_KEY=
